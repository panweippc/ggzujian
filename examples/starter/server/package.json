{
  "name": "my-project-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sql:bundle": "node scripts/bundle-sql.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:compat": "node scripts/check-compat.mjs --driver postgres",
    "check:audit": "node scripts/check-audit.mjs --level critical --omit dev --allow-list xlsx",
    "check:drift": "node scripts/check-schema-drift.mjs --dry-run",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:quality": "node scripts/check-code-quality.mjs",
    "check:compliance": "node scripts/check-compliance.mjs",
    "check:api-exposure": "node scripts/check-api-exposure.mjs",
    "check:config-baseline": "node scripts/check-config-baseline.mjs",
    "check:sql-safety": "node scripts/check-sql-safety.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:sbom": "node scripts/check-sbom.mjs",
    "check:data-classification": "node scripts/check-data-classification.mjs",
    "check:permission-matrix": "node scripts/check-permission-matrix.mjs",
    "check:backup-drill": "node scripts/check-backup-drill.mjs",
    "check:complexity": "node scripts/check-complexity.mjs",
    "check:unused-deps": "node scripts/check-unused-deps.mjs",
    "check:ts-strict": "node scripts/check-ts-strict.mjs",
    "check:api-contract": "node scripts/check-api-contract.mjs",
    "check:extended": "npm run check:api-exposure && npm run check:config-baseline && npm run check:sql-safety && npm run check:coverage && npm run check:sbom && npm run check:data-classification && npm run check:permission-matrix && npm run check:backup-drill && npm run check:complexity && npm run check:unused-deps && npm run check:ts-strict && npm run check:api-contract",
    "check:all": "npm run check:env && npm run check:compat && npm run check:audit && npm run check:secrets && npm run check:extended",
    "gen:ddl": "node scripts/generate-dialect-ddl.mjs",
    "gen:openapi": "node scripts/generate-openapi.mjs",
    "gen:demo": "node scripts/generate-demo-data.mjs",
    "init:admin": "node scripts/init-admin.mjs",
    "backup:run": "node scripts/backup-orchestrator.mjs",
    "secrets:rotate": "node scripts/rotate-secrets.mjs"
  },
  "dependencies": {
    "@panweippc/auth-kit": "file:../../../packages/auth-kit",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^1.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.0",
    "pg": "^8.23.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.2"
  }
}
