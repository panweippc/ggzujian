# ===== 服务端口（可选，默认 3011）=====
# 后端从 PORT 起始探测，被占用则自动 +1 顺延，并把实际端口写入 server/.runtime-port.json
# 前端 vite 会读取该文件自动代理，无需手动填写；前端端口默认 3008，占用也自动顺延
PORT=3011

# ===== 数据库 =====
# DB_DRIVER=auto 或留空时自动识别真实数据库（按连接串 scheme/端口推断 + version() 校验），
# 识别不出会明确报错并打印原始版本串，绝不静默套用方言。
DB_DRIVER=auto             # auto / mysql / postgres / kingbase / opengauss / dameng / mongodb / influxdb（后两个占位，会明确报错）
DB_HOST=127.0.0.1
DB_PORT=3306              # MySQL 3306；PG/openGauss 5432；达梦 5236；人大金仓 54321
DB_USER=root
DB_PASSWORD=请替换为数据库密码
DB_NAME=my_project
# PostgreSQL 协议栈（DB_DRIVER=postgres/kingbase/opengauss/dameng 时生效）
PG_URL=                   # 连接串，填了则覆盖下面 host/port/user/password/name
DB_POOL_MAX=10
PG_SSL=false              # true 时以 rejectUnauthorized:false 建立 SSL（自签名场景）
# 自动识别/启动自检开关
DB_STRICT_DRIVER_MATCH=false  # true：识别结果与 DB_DRIVER 不一致时启动失败（默认仅警告）
DB_STRICT_BOOT=false          # true：自检失败时崩溃退出（生产建议开启；开发期默认仅警告）
DB_SKIP_COMPAT_CHECK=false    # true：跳过启动自检（仅紧急情况，不建议生产使用）
DATABASE_URL=                 # 通用连接串（PG 协议栈，PG_URL 的别名；填了则覆盖 host/port/user/password/name）

# ===== JWT 认证（务必用强随机串，生产环境缺失会拒绝启动）=====
JWT_SECRET=请替换为强随机密钥
JWT_SECRET_PREVIOUS=
JWT_EXPIRES=12h
# 管理员初始密码：供 node scripts/init-admin.mjs 一键创建/重置 admin（留空则该脚本拒绝运行）
ADMIN_INIT_PASSWORD=
# 电子签章密钥（独立于 JWT，避免一处泄露影响两处；留空则兼容回退 JWT_SECRET 并在生产告警）
SIGN_SECRET=请替换为独立于JWT的签章密钥

# ===== 安全告警（可选）=====
ALERT_WEBHOOK_URL=

# ===== 统一网关（可选，有默认值）=====
RATE_WINDOW_MS=60000        # 全局限流窗口
RATE_MAX=300                # 全局每窗口最大请求数
WRITE_RATE_MAX=60           # 写操作(POST/PUT/DELETE)每窗口上限
LOGIN_RATE_MAX=10           # 登录每15分钟上限
LOGIN_MAX_FAILS=5           # 连续登录失败次数上限，超过则锁定账号
LOGIN_LOCK_MS=900000        # 账号锁定时长（默认 15 分钟）
SLOW_REQUEST_MS=800         # 慢接口阈值（超时写安全告警）
DICT_CACHE_TTL_MS=300000    # 数据字典缓存时长（默认 5 分钟）

# ===== 全留痕审计（可选，默认开启写操作全记录）=====
AUTO_AUDIT_ENABLED=true     # 网关自动记录所有写操作；手动已记的自动去重
AUDIT_READS=false            # true 时连 GET 查询也记录（日志量会大增，慎用）
RECYCLE_KEEP_DAYS=30         # 回收站保留天数，过期每小时自动清除
IDEMPOTENCY_WINDOW_MS=86400000  # 幂等键缓存窗口（默认24小时）
API_VERSION=v1               # 响应头 X-API-Version 值
RUNTIME_CONFIG_TTL_MS=10000  # 运行时配置缓存时长（驱动/维护模式切换后会自动刷新；STORAGE_DRIVER 仅作初始值）

# ===== 统一文件服务（可选）=====
STORAGE_DRIVER=local        # local（默认）/ minio / oss（后两者需接入 SDK）
FILE_MAX_SIZE=20971520      # 单文件上限，默认20MB
# MinIO（STORAGE_DRIVER=minio 时填写）：留空=local 本地磁盘；填齐后需接入 MinIO SDK 适配器
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_USE_SSL=false
# 阿里云 OSS（STORAGE_DRIVER=oss 时填写）：留空=local 本地磁盘；填齐后需接入 OSS SDK 适配器
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
# 文件在线预览：Office(doc/docx/xls/xlsx/ppt/pptx) 需外部文档转换服务（LibreOffice/OnlyOffice 等）
# 留空=Office 仅可下载（预览接口返回明确提示）；图片/PDF/TXT/MD/CSV/JSON 始终可内联预览
CONVERT_URL=

# ===== 统一消息通道（可选，留空走控制台适配器）=====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false           # true：SMTP 走 SSL/TLS（465 端口通常用 true，587 用 false）
DEFAULT_MESSAGE_CHANNEL=inapp  # 默认消息通道：inapp / email / sms / wechat
SMS_API_URL=
SMS_API_KEY=
SMS_SIGN=
WECHAT_WEBHOOK=

# ===== 平台化能力：外部资源配置位（全部留空 → 走本地实现，无需任何外部服务）=====
# 缓存：留空=内存 LRU（开箱即用）；填 REDIS_URL 需接入 Redis 适配器（services/platform.js）
REDIS_URL=
CACHE_MAX_KEYS=2000
# 事件总线：留空=内存 EventEmitter（开箱即用）；填 MQ_URL 需接入 RabbitMQ/Kafka 适配器
MQ_URL=
# 密钥管理：留空=本地 AES-256-GCM（开箱即用，主密钥取 JWT_SECRET）；填 KMS_URL 需接入 KMS 适配器
KMS_URL=
SECRETS_MASTER_KEY=
# AI 助手：留空=内置演示回答（开箱即用）；填 LLM_API_URL 走 OpenAI 兼容 chat/completions 接口
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=20000
# 链路追踪：留空=内存 span 环形缓冲（开箱即用）；填 OTLP_ENDPOINT 需接入 OTLP 上报适配器
OTLP_ENDPOINT=
# 向量库（RAG 语义检索预留）：留空=文件名关键词检索；填 VECTOR_DB_URL 需接入向量库
VECTOR_DB_URL=
# 日志聚合（ELK）：留空=本地文件日志；填 ELK_URL 需接入 Elasticsearch/Kibana 日志适配器
ELK_URL=
ELK_INDEX=
KIBANA_URL=
# 链路追踪 Jaeger 直连（与 OTLP_ENDPOINT 二选一）：填 JAEGER_URL 需接入 Jaeger 上报适配器
JAEGER_URL=
# 前端异常上报：留空=不上报；填 SENTRY_DSN 需接入 Sentry SDK（web 端）
SENTRY_DSN=
# 天气（登录页，公开 API）
WEATHER_LAT=40.8424
WEATHER_LON=111.7490

# ===== 监控栈（docker-compose 可选服务）=====
# Grafana 默认管理员账号密码（首次启动生效；生产务必修改）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
# 说明：后端 /metrics 无需配置即可访问；Prometheus 抓取目标写在 monitoring/prometheus.yml，
#       Grafana 数据源与面板在 monitoring/grafana/provisioning 下自动加载。

# ===== 数据安全（方案 C：备份校验 + 出口分级 + 字段加解密）=====
# 字段加密主密钥：留空回退 SECRETS_MASTER_KEY / JWT_SECRET（会告警），生产务必配置独立密钥
DATA_ENCRYPT_KEY=
DATA_ENCRYPT_KEY_PREVIOUS=   # 密钥轮换：旧密钥，多个用英文逗号分隔；解密时逐个尝试
# 备份加密：BACKUP_ENCRYPT_KEY 留空回退 JWT_SECRET；BACKUP_ENCRYPT=false 可明文落盘（不推荐）
BACKUP_ENCRYPT_KEY=
BACKUP_ENCRYPT=true
BACKUP_REMOTE_DIR=           # 异地留存目录（挂载点/另一块盘）；留空仅本地保存
BACKUP_RETENTION_DAYS=0      # 自动清理超过 N 天的备份及其清单，0=不清理
BACKUP_REQUIRE_VERIFY=true   # 恢复前强制完整性校验，校验失败拒绝恢复
BACKUP_PRE_RESTORE_SNAPSHOT=true  # 恢复前先自动留一份当前库快照
# 查询出口分级：low(全部审批)/medium(PII及以上，默认)/high(仅高风险)
EXPORT_POLICY=medium
EXPORT_MAX_ROWS=10000        # 单次导出行数硬上限
EXPORT_APPROVAL_TTL_MS=1800000  # 审批单有效期（默认 30 分钟），过期需重新申请

# ===== 前端一键安全自检（管理端 /api/security/checks、/api/security/run）=====
# 生产环境默认关闭；开发环境默认开启。显式 true/false 优先于环境推断。
SECURITY_UI_ENABLED=false      # 生产如需开启改为 true（仅管理员可用，脚本固定白名单、无 shell 执行）
SECURITY_UI_TIMEOUT_MS=45000   # 单次检测超时
SECURITY_UI_RATE_MAX=5         # 每用户+IP 在窗口期内最多执行次数
SECURITY_UI_RATE_WINDOW_MS=60000
