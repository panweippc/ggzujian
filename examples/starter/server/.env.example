# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请替换为数据库密码
DB_NAME=my_project

# ===== JWT 认证（务必用强随机串，生产环境缺失会拒绝启动）=====
JWT_SECRET=请替换为强随机密钥
JWT_SECRET_PREVIOUS=
JWT_EXPIRES=12h

# ===== 安全告警（可选）=====
ALERT_WEBHOOK_URL=

# ===== 统一网关（可选，有默认值）=====
RATE_WINDOW_MS=60000        # 全局限流窗口
RATE_MAX=300                # 全局每窗口最大请求数
WRITE_RATE_MAX=60           # 写操作(POST/PUT/DELETE)每窗口上限
LOGIN_RATE_MAX=10           # 登录每15分钟上限
SLOW_REQUEST_MS=800         # 慢接口阈值（超时写安全告警）

# ===== 统一文件服务（可选）=====
STORAGE_DRIVER=local        # local（默认）/ minio / oss（后两者需接入 SDK）
FILE_MAX_SIZE=20971520      # 单文件上限，默认20MB

# ===== 统一消息通道（可选，留空走控制台适配器）=====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMS_API_URL=
SMS_API_KEY=
SMS_SIGN=
WECHAT_WEBHOOK=
