{
  "table": "products",
  "entity": "product",
  "Entity": "ProductView",
  "route": "products",
  "title": "商品",
  "icon": "Goods",
  "fields": [
    { "name": "name", "label": "商品名称", "type": "text", "required": true, "sqlType": "VARCHAR(200)" },
    { "name": "category", "label": "分类", "type": "select", "options": [{ "label": "电子产品", "value": "电子" }, { "label": "日用品", "value": "日用" }], "sqlType": "VARCHAR(50)" },
    { "name": "price", "label": "单价", "type": "number", "sqlType": "DECIMAL(10,2)" },
    { "name": "stock", "label": "库存", "type": "number", "sqlType": "INT DEFAULT 0" },
    { "name": "status", "label": "状态", "type": "select", "options": [{ "label": "上架", "value": "on" }, { "label": "下架", "value": "off" }], "sqlType": "VARCHAR(20)" },
    { "name": "remark", "label": "备注", "type": "textarea", "sqlType": "TEXT" }
  ]
}
